APP_DB_PATH=./data/app.sqlite
DRAFT_ASSETS_DIR=./data/draft-assets
OPENROUTER_API_KEY=
# Optional override used by local/integration environments.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://easyclass.app
OPENROUTER_APP_NAME=EasyClass
DRAWTHINGS_GRPC_ADDRESS=127.0.0.1:17859
DRAWTHINGS_CONNECT_TIMEOUT_MS=2000
# Optional exact filenames/config overrides for the installed Draw Things model.
DRAWTHINGS_MODEL=qwen_image_2512_q6p.ckpt
DRAWTHINGS_LORA=qwen_image_2512_lightning_4_step_v1.0_lora_f16.ckpt
DRAWTHINGS_LORA_WEIGHT=1
# DRAWTHINGS_CONFIG_JSON={"steps":4,"guidanceScale":1,"shift":3}
# DRAWTHINGS_NEGATIVE_PROMPT=low quality, blurry, text, watermark, logo

# WebRTC uses the public Google STUN server by default. Production calls also
# need coturn and temporary credentials generated from the same shared secret.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# WEBRTC_TURN_SHARED_SECRET=replace-with-a-long-random-secret
# WEBRTC_TURN_CREDENTIAL_TTL_SECONDS=3600
